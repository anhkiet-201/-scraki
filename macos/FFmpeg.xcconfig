// Build settings for VideoDecoderPlugin — now using VideoToolbox directly.
// FFmpeg dependency has been removed. VideoToolbox is part of macOS SDK
// and does not require any Homebrew install.

// Link against VideoToolbox (hardware video decode) and CoreMedia/CoreVideo
OTHER_LDFLAGS = $(inherited) -framework VideoToolbox -framework CoreMedia -framework CoreVideo -framework AVFoundation

// Runtime search paths (keep for other dependencies)
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
